<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CourseSellingApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:CourseSellingApp.Models"
        xmlns:services="using:CourseSellingApp.Services"
        xmlns:utils="using:CourseSellingApp.Utils"
        xmlns:controls="using:CourseSellingApp.Views.CustomControls"
        xmlns:views="using:CourseSellingApp.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CourseSellingApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app_icon.ico"
        Title="{DynamicResource Title}">

    <Window.Resources>
        <utils:BitmapValueConverter x:Key="BitmapValueConverter"/>
    </Window.Resources>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <!-- Course Browser View -->
        <Grid IsVisible="{Binding !IsAdmin}" ColumnDefinitions="300,*" RowDefinitions="Auto,Auto,*" Margin="10">
        <Grid Grid.ColumnSpan="2" Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Header.AvailableCourses}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                <Button Content="{DynamicResource Header.Help}" Command="{x:Static utils:AppCommands.ShowHelpCommand}" />
                <Button Content="{DynamicResource Header.ProfileBtn}" Command="{Binding OpenProfileCommand}" />
                <Button Content="{DynamicResource Header.LoginClient}" Command="{Binding LoginCommand}">
                    <Button.CommandParameter>
                        <services:UserRole>Client</services:UserRole>
                    </Button.CommandParameter>
                </Button>
                <Button Content="{DynamicResource Header.LoginAdmin}" Command="{Binding LoginCommand}">
                    <Button.CommandParameter>
                        <services:UserRole>Administrator</services:UserRole>
                    </Button.CommandParameter>
                </Button>
            </StackPanel>
        </Grid>



        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,10">
                <TextBox Text="{Binding SearchQuery}" Watermark="{DynamicResource Filter.Search}" />
                <ComboBox ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          PlaceholderText="{DynamicResource Filter.Category}"
                          HorizontalAlignment="Stretch"/>
                <StackPanel VerticalAlignment="Center">
                    <Grid ColumnDefinitions="*,Auto,*">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Filter.MinPrice}" FontSize="12" Foreground="Gray" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource Filter.MaxPrice}" FontSize="12" Foreground="Gray" HorizontalAlignment="Right"/>
                    </Grid>
                    <controls:RangeSlider Minimum="0" Maximum="3000" LowerValue="{Binding MinPriceDouble, Mode=TwoWay}" UpperValue="{Binding MaxPriceDouble, Mode=TwoWay}" Margin="0,5"/>
                    <Grid ColumnDefinitions="*,Auto,*">
                        <TextBlock Grid.Column="0" Text="{Binding MinPriceDouble, StringFormat={}{0:0} BYN}" FontSize="12" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="2" Text="{Binding MaxPriceDouble, StringFormat={}{0:0} BYN}" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding FilteredCourses}" SelectedItem="{Binding SelectedCourse}" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Course">
                        <controls:AnimatedCourseCard />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Grid>

        <Border Grid.Column="1" Grid.Row="2" BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="10,0,0,0">
            <Panel>
                <TextBlock Text="{DynamicResource Text.SelectCourse}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="Gray"
                           IsVisible="{Binding SelectedCourse, Converter={x:Static ObjectConverters.IsNull}}"/>

                <ContentControl Content="{Binding SelectedCourse}"
                                IsVisible="{Binding SelectedCourse, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="models:Course">
                            <ScrollViewer>
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding FullName}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>

                                    <Border MaxHeight="300" CornerRadius="8" ClipToBounds="True" Background="Transparent" HorizontalAlignment="Center" Margin="0,10">
                                        <Panel>
                                            <Image Source="{Binding CoverImagePath, Converter={StaticResource BitmapValueConverter}}" Stretch="Uniform"/>
                                            <TextBlock Text="{DynamicResource Image.Placeholder}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       IsVisible="{Binding CoverImagePath, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                        </Panel>
                                    </Border>

                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                    <Separator/>
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Details.Category}" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Category}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Details.Rating}" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Rating, StringFormat={}{0}/5.0}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Details.Price}" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Price, StringFormat={}{0:0.00 BYN}}" Foreground="Green"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Details.Author}" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Author}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Details.AvailableSlots}" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Quantity}"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Panel>
        </Border>
        </Grid>

        <!-- Admin Panel View -->
        <Grid IsVisible="{Binding IsAdmin}">
            <views:AdminView DataContext="{Binding AdminViewModel}" />
        </Grid>
    </Grid>
</Window>

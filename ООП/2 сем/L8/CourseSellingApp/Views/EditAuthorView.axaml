<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CourseSellingApp.ViewModels"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
        x:Class="CourseSellingApp.Views.EditAuthorView"
        x:DataType="vm:EditAuthorViewModel"
        Title="{DynamicResource Admin.Authors.EditTitle}"
        WindowStartupLocation="CenterOwner"
        Width="400" Height="300">

    <Grid RowDefinitions="*,Auto" Margin="15">
        <StackPanel Grid.Row="0" Spacing="10">
            <TextBlock Text="{DynamicResource Admin.Authors.FullName}"/>
            <TextBox Text="{Binding Author.FullName}"/>

            <TextBlock Text="{DynamicResource Admin.Authors.Biography}"/>
            <TextBox Text="{Binding Author.Biography}" TextWrapping="Wrap" Height="100" AcceptsReturn="True"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{DynamicResource Edit.Save}" Command="{Binding SaveCommand}" IsDefault="True"/>
            <Button Content="{DynamicResource Edit.Cancel}" Command="{Binding CancelCommand}" IsCancel="True"/>
        </StackPanel>
    </Grid>

</Window>

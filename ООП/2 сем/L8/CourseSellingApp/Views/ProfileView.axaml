<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CourseSellingApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="350"
        x:Class="CourseSellingApp.Views.ProfileView"
        x:DataType="vm:ProfileViewModel"
        Title="{DynamicResource Profile.Title}"
        Width="650" Height="350"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

    <Design.DataContext>
        <vm:ProfileViewModel/>
    </Design.DataContext>

    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="{DynamicResource Profile.Header}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AppForegroundBrush}"/>

        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,10,0,0">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Profile.Name}" VerticalAlignment="Center" Margin="0,0,10,10" Foreground="{DynamicResource AppForegroundBrush}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding UserName}" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Profile.Email}" VerticalAlignment="Center" Margin="0,0,10,10" Foreground="{DynamicResource AppForegroundBrush}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Email}" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Profile.Language}" VerticalAlignment="Center" Margin="0,0,10,10" Foreground="{DynamicResource AppForegroundBrush}"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                <Button Content="{DynamicResource Profile.Language.English}" Command="{Binding ChangeLanguageCommand}" CommandParameter="en-US" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ButtonForegroundBrush}"/>
                <Button Content="{DynamicResource Profile.Language.Russian}" Command="{Binding ChangeLanguageCommand}" CommandParameter="ru-RU" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ButtonForegroundBrush}"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Profile.Theme}" VerticalAlignment="Center" Margin="0,0,10,10" Foreground="{DynamicResource AppForegroundBrush}"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                <Button Content="{DynamicResource Profile.Theme.Optimistic}" Command="{Binding ChangeThemeCommand}" CommandParameter="OptimisticTheme" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ButtonForegroundBrush}"/>
                <Button Content="{DynamicResource Profile.Theme.Pink}" Command="{Binding ChangeThemeCommand}" CommandParameter="PinkTheme" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ButtonForegroundBrush}"/>
                <Button Content="{DynamicResource Profile.Theme.Grayscale}" Command="{Binding ChangeThemeCommand}" CommandParameter="GrayscaleTheme" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ButtonForegroundBrush}"/>
                <Button Content="{DynamicResource Profile.Theme.Dark}" Command="{Binding ChangeThemeCommand}" CommandParameter="DarkTheme" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ButtonForegroundBrush}"/>
            </StackPanel>
        </Grid>

        <Button Content="{DynamicResource Profile.SaveChanges}" Command="{Binding SaveChangesCommand}" HorizontalAlignment="Center" Margin="0,10,0,0"
                Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ButtonForegroundBrush}"/>
    </StackPanel>
</Window>

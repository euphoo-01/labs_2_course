<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CourseSellingApp.ViewModels"
             xmlns:m="using:CourseSellingApp.Models"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="CourseSellingApp.Views.CoursesView"
             x:DataType="vm:CoursesViewModel">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Admin.Courses.Title}" FontSize="20" FontWeight="Bold" Margin="10" Foreground="{DynamicResource AppForegroundBrush}"/>

        <!-- Action Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="{DynamicResource Admin.Courses.Add}"
                    Command="{Binding AddCourseCommand}"
                    Margin="5"/>
            <Button Content="{DynamicResource Admin.Courses.Edit}"
                    Command="{Binding EditCourseCommand}"
                    CommandParameter="{Binding $parent[DataGrid].SelectedItem}"
                    Margin="5"/>
            <Button Content="{DynamicResource Admin.Courses.Delete}"
                    Command="{Binding DeleteCourseCommand}"
                    CommandParameter="{Binding $parent[DataGrid].SelectedItem}"
                    Margin="5"/>
        </StackPanel>

        <!-- Courses DataGrid -->
        <DataGrid Name="CoursesGrid"
                  ItemsSource="{Binding Courses}"
                  SelectedItem="{Binding SelectedCourse}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserSortColumns="True"
                  Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Admin.Courses.ID}" Binding="{Binding Id}" SortMemberPath="Id" Width="Auto"/>
                <DataGridTextColumn Header="{DynamicResource Admin.Courses.Name}" Binding="{Binding Name}" SortMemberPath="Name" Width="2*"/>
                <DataGridTextColumn Header="{DynamicResource Admin.Courses.Author}" Binding="{Binding Author}" SortMemberPath="Author" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource Admin.Courses.Category}" Binding="{Binding Category}" SortMemberPath="Category" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource Admin.Courses.Price}" Binding="{Binding Price}" SortMemberPath="Price" Width="Auto"/>
                <DataGridCheckBoxColumn Header="{DynamicResource Admin.Courses.Available}" Binding="{Binding IsAvailable}" SortMemberPath="IsAvailable" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>

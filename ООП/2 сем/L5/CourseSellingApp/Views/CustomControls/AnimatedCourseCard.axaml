<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:CourseSellingApp.Models"
             xmlns:utils="using:CourseSellingApp.Utils"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="120"
             x:Class="CourseSellingApp.Views.CustomControls.AnimatedCourseCard"
             x:DataType="models:Course">

    <UserControl.Resources>
        <utils:BitmapValueConverter x:Key="BitmapValueConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.card">
            <!-- Styling and visual effects -->
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BoxShadow" Value="0 2 6 0 #20000000"/>
            <Setter Property="BorderBrush" Value="#20000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <!-- Animation transitions -->
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>

        <!-- Hover visual effects and animation -->
        <Style Selector="Border.card:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)"/>
            <Setter Property="BoxShadow" Value="0 8 20 0 #40000000"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="card" Margin="10">
        <i:Interaction.Behaviors>
            <ia:EventTriggerBehavior EventName="PointerEntered">
                <ia:ChangePropertyAction TargetObject="{Binding #PriceText}" PropertyName="Foreground" Value="Orange" />
            </ia:EventTriggerBehavior>
            <ia:EventTriggerBehavior EventName="PointerExited">
                <ia:ChangePropertyAction TargetObject="{Binding #PriceText}" PropertyName="Foreground" Value="#388E3C" />
            </ia:EventTriggerBehavior>
            <ia:DataTriggerBehavior Binding="{Binding Quantity}" ComparisonCondition="Equal" Value="0">
                <ia:ChangePropertyAction TargetObject="{Binding #CardGrid}" PropertyName="Opacity" Value="0.5" />
            </ia:DataTriggerBehavior>
            <ia:DataTriggerBehavior Binding="{Binding Quantity}" ComparisonCondition="GreaterThan" Value="0">
                <ia:ChangePropertyAction TargetObject="{Binding #CardGrid}" PropertyName="Opacity" Value="1.0" />
            </ia:DataTriggerBehavior>
        </i:Interaction.Behaviors>
        <Grid Name="CardGrid" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,*" Margin="10">
            <!-- Thumbnail Graphic -->
            <Border Grid.RowSpan="3" Width="90" Height="90" CornerRadius="8" ClipToBounds="True" Background="#E0E0E0" Margin="0,0,15,0">
                <Panel>
                    <Image Source="{Binding CoverImagePath, Converter={StaticResource BitmapValueConverter}}" Stretch="UniformToFill"/>
                    <TextBlock Text="No Image" VerticalAlignment="Center" HorizontalAlignment="Center"
                               IsVisible="{Binding CoverImagePath, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                               Foreground="#757575" FontSize="11" FontWeight="SemiBold"/>
                </Panel>
            </Border>

            <!-- Text Content -->
            <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="16"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AppForegroundBrush}"/>

            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Author}" FontStyle="Italic"
                       Foreground="{DynamicResource AppForegroundBrush}" Opacity="0.7" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>

            <!-- Graphics and Details -->
            <Grid Grid.Column="1" Grid.Row="2" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Bottom" Margin="0,10,0,0">

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                    <!-- Vector Star Graphic -->
                    <PathIcon Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z"
                              Foreground="#FFC107" Width="14" Height="14"/>
                    <TextBlock Text="{Binding Rating, StringFormat={}{0:F1}}" FontSize="13"
                               FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}"/>
                </StackPanel>

                <TextBlock x:Name="PriceText" Grid.Column="2" Text="{Binding Price, StringFormat={}{0:0.00} BYN}"
                           FontWeight="Bold" Foreground="#388E3C" FontSize="15" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>

</UserControl>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFEEEEEE"/>
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#FF212121"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FF9E9E9E"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#FFE0E0E0"/>
</ResourceDictionary>

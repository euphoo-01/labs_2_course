<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CourseSellingApp.Views.HelpWindow"
        Title="{DynamicResource Help.Title}"
        Width="350" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="20" Spacing="15" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource Help.Description}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   FontSize="16"/>

        <TextBlock Text="{DynamicResource Help.Author}"
                   FontWeight="Bold"
                   TextAlignment="Center"
                   FontSize="14"/>

        <Button Content="{DynamicResource Help.Telegram}"
                Background="Transparent"
                Foreground="Blue"
                Cursor="Hand"
                HorizontalAlignment="Center"
                Click="OnTelegramClicked">
            <Button.Styles>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
                </Style>
            </Button.Styles>
        </Button>
    </StackPanel>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="50"
             x:Class="CourseSellingApp.Views.CustomControls.StarRatingControl">
    <StackPanel Orientation="Horizontal" Spacing="4" Name="StarsPanel">
        <!-- Stars will be populated programmatically -->
    </StackPanel>
</UserControl>
